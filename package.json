{
  "name": "nonchalant-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit && pnpm check:boundaries && pnpm check:docs",
    "check:boundaries": "tsc -p packages/core/tsconfig.json && tsc -p packages/wire/tsconfig.json && tsc -p packages/durable/tsconfig.json && tsc -p packages/host/tsconfig.json",
    "check:docs": "node --experimental-strip-types --no-warnings scripts/check-doc-samples.ts",
    "test": "vitest run",
    "build": "pnpm -r run build",
    "changeset": "changeset",
    "verify:pack": "node --experimental-strip-types --no-warnings scripts/verify-pack.ts",
    "test:watch": "vitest",
    "coverage": "vitest run --project unit --coverage",
    "dev": "vite --open /",
    "build:site": "vite build",
    "preview:site": "vite preview",
    "cart-server": "vite-node examples/shared-cart/server.ts",
    "chat-server": "vite-node examples/chat/server.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "fast-check": "^4.1.0",
    "happy-dom": "^20.11.6",
    "mermaid": "^11.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@nonchalant/core": "workspace:*",
    "@nonchalant/dom": "workspace:*",
    "@nonchalant/durable": "workspace:*",
    "@nonchalant/host": "workspace:*",
    "@nonchalant/inspect": "workspace:*",
    "@nonchalant/react": "workspace:*",
    "@nonchalant/wire": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
