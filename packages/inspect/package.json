{
  "name": "@nonchalant/inspect",
  "version": "0.0.0",
  "private": true,
  "description": "A process inspector for nonchalant: the process tree, a timeline of messages, yields and patches, and time travel.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twfarland/nonchalant.git",
    "directory": "packages/inspect"
  },
  "homepage": "https://github.com/twfarland/nonchalant#readme",
  "bugs": "https://github.com/twfarland/nonchalant/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node --experimental-strip-types --no-warnings ../../scripts/build.ts"
  },
  "peerDependencies": {
    "@nonchalant/core": "workspace:^",
    "@nonchalant/dom": "workspace:^"
  },
  "devDependencies": {
    "@nonchalant/core": "workspace:*",
    "@nonchalant/dom": "workspace:*"
  }
}
